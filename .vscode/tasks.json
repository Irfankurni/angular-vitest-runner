{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "esbuild: compile",
			"type": "shell",
			"command": "node esbuild.js",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "esbuild: watch",
			"type": "shell",
			"command": "node esbuild.js --watch",
			"isBackground": true,
			"group": "build",
			"presentation": {
				"reveal": "never",
				"panel": "shared"
			},
			"problemMatcher": {
				"owner": "esbuild",
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+): (error|warning): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "\\[watch\\] build started",
					"endsPattern": "⚡ Done"
				}
			}
		}
	]
}
